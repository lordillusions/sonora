{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Sonora control request 1.0",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "apiVersion",
  "operation"
 ],
 "properties": {
  "apiVersion": {
   "const": "1.0"
  },
  "operation": {
   "enum": [
    "project.inspect",
    "capabilities.get",
    "clips.get",
    "devices.parameters",
    "edits.apply",
    "workflow.serum_supersaw",
    "history.undo",
    "devices.parameters.set",
    "devices.catalog",
    "devices.insert",
    "devices.remove",
    "automation.get",
    "status.get",
    "history.step",
    "clips.import_audio",
    "devices.move",
    "mixer.set",
    "transport.set",
    "session.launch",
    "recording.set",
    "project.save",
    "plugins.scan",
    "devices.set_enabled",
    "project.save_copy",
    "project.export_audio",
    "project.export_cancel",
    "view.set",
    "devices.open_editor",
    "media.run"
   ]
  },
  "target": {
   "$ref": "#/$defs/target"
  },
  "expectedRevision": {
   "type": "string",
   "minLength": 1
  },
  "idempotencyKey": {
   "type": "string",
   "minLength": 1,
   "maxLength": 128
  },
  "arguments": {
   "type": "object"
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "operation": {
      "enum": [
       "clips.get",
       "devices.parameters",
       "edits.apply",
       "workflow.serum_supersaw",
       "history.undo",
       "devices.parameters.set",
       "devices.catalog",
       "devices.insert",
       "devices.remove",
       "automation.get",
       "status.get",
       "history.step",
       "clips.import_audio",
       "devices.move",
       "mixer.set",
       "transport.set",
       "session.launch",
       "recording.set",
       "project.save",
       "plugins.scan",
       "devices.set_enabled",
       "project.save_copy",
       "project.export_audio",
       "project.export_cancel",
       "view.set",
       "devices.open_editor",
       "media.run"
      ]
     }
    }
   },
   "then": {
    "required": [
     "target",
     "arguments"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "operation": {
      "enum": [
       "edits.apply",
       "workflow.serum_supersaw",
       "history.undo",
       "devices.parameters.set",
       "devices.insert",
       "devices.remove",
       "history.step",
       "clips.import_audio",
       "devices.move"
      ]
     }
    }
   },
   "then": {
    "required": [
     "expectedRevision",
     "idempotencyKey"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "operation": {
      "const": "clips.get"
     }
    }
   },
   "then": {
    "properties": {
     "arguments": {
      "$ref": "#/$defs/clipQuery"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "operation": {
      "const": "devices.parameters"
     }
    }
   },
   "then": {
    "properties": {
     "arguments": {
      "$ref": "#/$defs/deviceQuery"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "operation": {
      "const": "history.undo"
     }
    }
   },
   "then": {
    "properties": {
     "arguments": {
      "$ref": "#/$defs/undo"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "operation": {
      "const": "workflow.serum_supersaw"
     }
    }
   },
   "then": {
    "properties": {
     "arguments": {
      "$ref": "#/$defs/serum"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "operation": {
      "const": "edits.apply"
     }
    }
   },
   "then": {
    "properties": {
     "arguments": {
      "$ref": "#/$defs/batch"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "operation": {
      "const": "devices.parameters.set"
     }
    }
   },
   "then": {
    "properties": {
     "arguments": {
      "$ref": "#/$defs/parameterBatch"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "operation": {
      "const": "devices.catalog"
     }
    }
   },
   "then": {
    "properties": {
     "arguments": {
      "$ref": "#/$defs/catalogQuery"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "operation": {
      "const": "devices.insert"
     }
    }
   },
   "then": {
    "properties": {
     "arguments": {
      "$ref": "#/$defs/deviceInsert"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "operation": {
      "const": "devices.remove"
     }
    }
   },
   "then": {
    "properties": {
     "arguments": {
      "$ref": "#/$defs/deviceQuery"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "operation": {
      "const": "automation.get"
     }
    }
   },
   "then": {
    "properties": {
     "arguments": {
      "$ref": "#/$defs/automationQuery"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "operation": {
      "const": "status.get"
     }
    }
   },
   "then": {
    "properties": {
     "arguments": {
      "$ref": "#/$defs/emptyArguments"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "operation": {
      "const": "history.step"
     }
    }
   },
   "then": {
    "properties": {
     "arguments": {
      "$ref": "#/$defs/historyStep"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "operation": {
      "const": "clips.import_audio"
     }
    }
   },
   "then": {
    "properties": {
     "arguments": {
      "$ref": "#/$defs/importAudio"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "operation": {
      "const": "devices.move"
     }
    }
   },
   "then": {
    "properties": {
     "arguments": {
      "$ref": "#/$defs/deviceMove"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "operation": {
      "const": "mixer.set"
     }
    }
   },
   "then": {
    "properties": {
     "arguments": {
      "$ref": "#/$defs/mixerSet"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "operation": {
      "const": "transport.set"
     }
    }
   },
   "then": {
    "properties": {
     "arguments": {
      "$ref": "#/$defs/transportSet"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "operation": {
      "const": "session.launch"
     }
    }
   },
   "then": {
    "properties": {
     "arguments": {
      "$ref": "#/$defs/sessionLaunch"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "operation": {
      "const": "recording.set"
     }
    }
   },
   "then": {
    "properties": {
     "arguments": {
      "$ref": "#/$defs/recordingSet"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "operation": {
      "const": "project.save"
     }
    }
   },
   "then": {
    "properties": {
     "arguments": {
      "$ref": "#/$defs/emptyArguments"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "operation": {
      "const": "plugins.scan"
     }
    }
   },
   "then": {
    "properties": {
     "arguments": {
      "$ref": "#/$defs/pluginsScan"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "operation": {
      "const": "devices.set_enabled"
     }
    }
   },
   "then": {
    "properties": {
     "arguments": {
      "$ref": "#/$defs/deviceEnabled"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "operation": {
      "enum": [
       "mixer.set",
       "transport.set",
       "session.launch",
       "recording.set",
       "project.save",
       "plugins.scan",
       "devices.set_enabled",
       "project.save_copy",
       "project.export_audio",
       "project.export_cancel",
       "view.set",
       "devices.open_editor",
       "media.run"
      ]
     }
    }
   },
   "then": {
    "not": {
     "anyOf": [
      {
       "required": [
        "expectedRevision"
       ]
      },
      {
       "required": [
        "idempotencyKey"
       ]
      }
     ]
    }
   }
  },
  {
   "if": {
    "properties": {
     "operation": {
      "const": "project.save_copy"
     }
    }
   },
   "then": {
    "properties": {
     "arguments": {
      "$ref": "#/$defs/saveCopy"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "operation": {
      "const": "project.export_audio"
     }
    }
   },
   "then": {
    "properties": {
     "arguments": {
      "$ref": "#/$defs/exportAudio"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "operation": {
      "const": "project.export_cancel"
     }
    }
   },
   "then": {
    "properties": {
     "arguments": {
      "$ref": "#/$defs/emptyArguments"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "operation": {
      "const": "view.set"
     }
    }
   },
   "then": {
    "properties": {
     "arguments": {
      "$ref": "#/$defs/viewSet"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "operation": {
      "const": "devices.open_editor"
     }
    }
   },
   "then": {
    "properties": {
     "arguments": {
      "$ref": "#/$defs/openEditor"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "operation": {
      "const": "media.run"
     }
    }
   },
   "then": {
    "properties": {
     "arguments": {
      "$ref": "#/$defs/mediaRun"
     }
    }
   }
  }
 ],
 "$defs": {
  "id": {
   "type": "integer",
   "minimum": 0,
   "maximum": 1000000000
  },
  "beat": {
   "type": "number",
   "minimum": 0,
   "maximum": 1000000
  },
  "target": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "instanceId",
    "documentId"
   ],
   "properties": {
    "instanceId": {
     "type": "string",
     "minLength": 1
    },
    "documentId": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "clipQuery": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "trackId",
    "clipId"
   ],
   "properties": {
    "trackId": {
     "$ref": "#/$defs/id"
    },
    "clipId": {
     "$ref": "#/$defs/id"
    },
    "scene": {
     "type": "integer",
     "minimum": 0,
     "maximum": 1000000
    },
    "laneId": {
     "$ref": "#/$defs/id"
    },
    "offset": {
     "$ref": "#/$defs/id"
    },
    "limit": {
     "type": "integer",
     "minimum": 1,
     "maximum": 4096
    }
   },
   "not": {
    "required": [
     "scene",
     "laneId"
    ]
   }
  },
  "deviceQuery": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "trackId",
    "deviceId"
   ],
   "properties": {
    "trackId": {
     "$ref": "#/$defs/id"
    },
    "deviceId": {
     "$ref": "#/$defs/id"
    }
   }
  },
  "undo": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "undoToken"
   ],
   "properties": {
    "undoToken": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "serum": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "root",
    "mode",
    "bars",
    "startBeat"
   ],
   "properties": {
    "root": {
     "const": "D#"
    },
    "mode": {
     "const": "minor"
    },
    "bars": {
     "const": 4
    },
    "startBeat": {
     "$ref": "#/$defs/beat"
    }
   }
  },
  "batch": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "commands"
   ],
   "properties": {
    "commands": {
     "type": "array",
     "minItems": 1,
     "maxItems": 32,
     "items": {
      "$ref": "#/$defs/edit"
     }
    }
   }
  },
  "edit": {
   "oneOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "type",
      "bpm"
     ],
     "properties": {
      "type": {
       "const": "tempo.set"
      },
      "bpm": {
       "type": "number",
       "minimum": 20,
       "maximum": 999
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "type",
      "trackId",
      "gainDb"
     ],
     "properties": {
      "type": {
       "const": "track.set_gain"
      },
      "trackId": {
       "$ref": "#/$defs/id"
      },
      "gainDb": {
       "type": "number",
       "minimum": -90,
       "maximum": 6
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "type",
      "trackId",
      "clipId",
      "destinationBeat"
     ],
     "properties": {
      "type": {
       "const": "clip.duplicate"
      },
      "trackId": {
       "$ref": "#/$defs/id"
      },
      "clipId": {
       "$ref": "#/$defs/id"
      },
      "destinationBeat": {
       "$ref": "#/$defs/beat"
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "type",
      "trackId",
      "clipId",
      "notes"
     ],
     "not": {
      "required": [
       "scene",
       "laneId"
      ]
     },
     "properties": {
      "trackId": {
       "$ref": "#/$defs/id"
      },
      "clipId": {
       "$ref": "#/$defs/id"
      },
      "scene": {
       "type": "integer",
       "minimum": 0,
       "maximum": 1000000
      },
      "laneId": {
       "$ref": "#/$defs/id"
      },
      "type": {
       "const": "notes.add"
      },
      "notes": {
       "type": "array",
       "minItems": 1,
       "maxItems": 4096,
       "items": {
        "$ref": "#/$defs/note"
       }
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "type",
      "trackId",
      "clipId",
      "notes"
     ],
     "not": {
      "required": [
       "scene",
       "laneId"
      ]
     },
     "properties": {
      "trackId": {
       "$ref": "#/$defs/id"
      },
      "clipId": {
       "$ref": "#/$defs/id"
      },
      "scene": {
       "type": "integer",
       "minimum": 0,
       "maximum": 1000000
      },
      "laneId": {
       "$ref": "#/$defs/id"
      },
      "type": {
       "const": "notes.replace"
      },
      "notes": {
       "type": "array",
       "minItems": 0,
       "maxItems": 4096,
       "items": {
        "$ref": "#/$defs/note"
       }
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "type",
      "trackId",
      "clipId",
      "updates"
     ],
     "not": {
      "required": [
       "scene",
       "laneId"
      ]
     },
     "properties": {
      "trackId": {
       "$ref": "#/$defs/id"
      },
      "clipId": {
       "$ref": "#/$defs/id"
      },
      "scene": {
       "type": "integer",
       "minimum": 0,
       "maximum": 1000000
      },
      "laneId": {
       "$ref": "#/$defs/id"
      },
      "type": {
       "const": "notes.update"
      },
      "updates": {
       "type": "array",
       "minItems": 1,
       "maxItems": 4096,
       "items": {
        "$ref": "#/$defs/noteUpdate"
       }
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "type",
      "trackId",
      "clipId",
      "noteIndices"
     ],
     "not": {
      "required": [
       "scene",
       "laneId"
      ]
     },
     "properties": {
      "trackId": {
       "$ref": "#/$defs/id"
      },
      "clipId": {
       "$ref": "#/$defs/id"
      },
      "scene": {
       "type": "integer",
       "minimum": 0,
       "maximum": 1000000
      },
      "laneId": {
       "$ref": "#/$defs/id"
      },
      "type": {
       "const": "notes.delete"
      },
      "noteIndices": {
       "type": "array",
       "minItems": 1,
       "maxItems": 4096,
       "items": {
        "$ref": "#/$defs/id"
       }
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "type",
      "beat"
     ],
     "properties": {
      "type": {
       "const": "locator.add"
      },
      "beat": {
       "$ref": "#/$defs/beat"
      },
      "name": {
       "$ref": "#/$defs/locatorName"
      },
      "color": {
       "$ref": "#/$defs/locatorColor"
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "minProperties": 3,
     "required": [
      "type",
      "locatorId"
     ],
     "properties": {
      "type": {
       "const": "locator.update"
      },
      "locatorId": {
       "$ref": "#/$defs/id"
      },
      "beat": {
       "$ref": "#/$defs/beat"
      },
      "name": {
       "$ref": "#/$defs/locatorName"
      },
      "infoText": {
       "type": "string",
       "maxLength": 4096
      },
      "color": {
       "$ref": "#/$defs/locatorColor"
      },
      "songStart": {
       "type": "boolean"
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "type",
      "locatorId"
     ],
     "properties": {
      "type": {
       "const": "locator.delete"
      },
      "locatorId": {
       "$ref": "#/$defs/id"
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "type",
      "folded"
     ],
     "properties": {
      "type": {
       "const": "track.set_folded"
      },
      "trackIds": {
       "type": "array",
       "maxItems": 1024,
       "items": {
        "$ref": "#/$defs/id"
       },
       "description": "Group track IDs; omit to fold or unfold every group"
      },
      "folded": {
       "type": "boolean"
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "type",
      "trackId",
      "lengthBeats"
     ],
     "not": {
      "required": [
       "startBeat",
       "scene"
      ]
     },
     "properties": {
      "type": {
       "const": "clip.create"
      },
      "trackId": {
       "$ref": "#/$defs/id"
      },
      "startBeat": {
       "$ref": "#/$defs/beat"
      },
      "scene": {
       "type": "integer",
       "minimum": 0,
       "maximum": 999
      },
      "lengthBeats": {
       "type": "number",
       "minimum": 0.015625,
       "maximum": 65536
      },
      "name": {
       "type": "string",
       "maxLength": 256
      },
      "notes": {
       "type": "array",
       "maxItems": 4096,
       "items": {
        "$ref": "#/$defs/note"
       }
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "type",
      "trackId",
      "clipId",
      "destinationBeat"
     ],
     "properties": {
      "type": {
       "const": "clip.copy"
      },
      "trackId": {
       "$ref": "#/$defs/id"
      },
      "clipId": {
       "$ref": "#/$defs/id"
      },
      "toTrackId": {
       "$ref": "#/$defs/id"
      },
      "destinationBeat": {
       "$ref": "#/$defs/beat"
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "type",
      "trackId",
      "clipId",
      "startBeat"
     ],
     "properties": {
      "type": {
       "const": "clip.move"
      },
      "trackId": {
       "$ref": "#/$defs/id"
      },
      "clipId": {
       "$ref": "#/$defs/id"
      },
      "toTrackId": {
       "$ref": "#/$defs/id"
      },
      "startBeat": {
       "$ref": "#/$defs/beat"
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "type",
      "trackId",
      "clipId"
     ],
     "not": {
