# COL-7: libopus (BSD-3-Clause, scripts/bootstrap.sh) encodes and decodes collab voice. Consumers link `sonora_opus` and
# test `#if SONORA_HAVE_OPUS`; without the download the target still exists (=0) and voice is off in the app.
set(_sonora_opus_dir "${SONORA_THIRD_PARTY_DIR}/opus")
if(EXISTS "${_sonora_opus_dir}/CMakeLists.txt")
    block()
        set(BUILD_SHARED_LIBS OFF)
        set(OPUS_BUILD_SHARED_LIBRARY OFF)
        set(OPUS_BUILD_TESTING OFF)
        set(OPUS_BUILD_PROGRAMS OFF)
        set(OPUS_INSTALL_PKG_CONFIG_MODULE OFF)
        set(OPUS_INSTALL_CMAKE_CONFIG_MODULE OFF)
        set(OPUS_DRED OFF)
        set(OPUS_OSCE OFF)
        set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
        add_subdirectory("${_sonora_opus_dir}" "${CMAKE_BINARY_DIR}/third_party/opus" EXCLUDE_FROM_ALL SYSTEM)
    endblock()
    if(MSVC)
        target_compile_options(opus PRIVATE /w)
    else()
        target_compile_options(opus PRIVATE -w)
    endif()
    set_target_properties(opus PROPERTIES POSITION_INDEPENDENT_CODE TRUE)
    add_library(sonora_opus INTERFACE)
    target_link_libraries(sonora_opus INTERFACE opus)
    target_compile_definitions(sonora_opus INTERFACE SONORA_HAVE_OPUS=1)
    file(READ "${_sonora_opus_dir}/SONORA_VERSION" _sonora_opus_version)
    string(STRIP "${_sonora_opus_version}" _sonora_opus_version)
    message(STATUS "Sonora: collab voice ON (libopus ${_sonora_opus_version})")
else()
    add_library(sonora_opus INTERFACE)
    target_compile_definitions(sonora_opus INTERFACE SONORA_HAVE_OPUS=0)
    message(STATUS "Sonora: libopus not found in ${_sonora_opus_dir}: collab voice off (run scripts/bootstrap.sh)")
endif()
