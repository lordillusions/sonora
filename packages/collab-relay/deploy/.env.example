# Written by deploy/gcp.sh on the VM. Copy to .env to run the stack anywhere else.
# Public name of the relay. Without your own domain, <public-ip-with-dashes>.sslip.io works (e.g. 34-75-1-2.sslip.io).
SONORA_RELAY_DOMAIN=relay.example.com
# The VM's public IPv4 and the private address of its network interface (the same on a VM without NAT).
SONORA_PUBLIC_IP=203.0.113.10
SONORA_PRIVATE_IP=10.142.0.2
# Shared by the relay and coturn: TURN credentials are HMACs of it. Generate with: openssl rand -hex 32
SONORA_TURN_SECRET=change-me
